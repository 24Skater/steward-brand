{
  "name": "@steward-apps/tokens",
  "version": "1.1.0",
  "description": "Design tokens for the Steward design system",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/24Skater/steward-brand.git",
    "directory": "packages/tokens"
  },
  "type": "module",
  "main": "./dist/tokens.js",
  "module": "./dist/tokens.js",
  "types": "./dist/tokens.d.ts",
  "exports": {
    ".": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js"
    },
    "./css": "./dist/tokens.css",
    "./dist/tokens.css": "./dist/tokens.css",
    "./json": "./dist/tokens.json",
    "./themes/accounting": "./dist/themes/accounting.css",
    "./themes/chms": "./dist/themes/chms.css",
    "./themes/crm": "./dist/themes/crm.css",
    "./themes/register": "./dist/themes/register.css",
    "./themes/table": "./dist/themes/table.css",
    "./themes/vbs": "./dist/themes/vbs.css",
    "./themes/website": "./dist/themes/website.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsx build/build-tokens.ts",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@steward-apps/tsconfig": "workspace:*",
    "@types/node": "^26.0.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
